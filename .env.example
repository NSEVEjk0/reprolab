# Set these privately on the dedicated Vultr host, never in the repository.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=glm-5.3-flash
REPROLAB_STATE_DIR=/var/lib/reprolab
REPROLAB_HOST=127.0.0.1
REPROLAB_PORT=8080
REPROLAB_ORIGIN=https://reprolab.example.com
REPROLAB_ACCESS_CODE=
REPROLAB_PUBLIC_JOBS=false
REPROLAB_DAILY_JOB_LIMIT=8
